{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "allowed": {
          ".read": "root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid",
          ".write": "auth != null && !data.exists() && newData.parent().child('meta/hostUid').val() === auth.uid",
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "meta": {
          ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
          "hostUid": {
            ".write": "auth != null && newData.val() === auth.uid && root.child('rooms').child($room).child('members').child(auth.uid).exists() && root.child('presence').child($room).child(data.val()).child('online').val() === false && root.child('presence').child($room).child(data.val()).child('lastSeen').val() < now - 60000"
          }
        },
        "members": {
          ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
          "$uid": {
            ".write": "(auth.uid === $uid && root.child('rooms').child($room).child('allowed').child(auth.uid).exists()) || root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('avatar').isString() && newData.child('avatar').val().length <= 16)",
            "ready": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "spectators": {
          ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth.uid === $uid && root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.parent().parent().child('spectatorSlots').child(newData.child('slot').val() + '').val() === $uid)"
          }
        },
        "spectatorSlots": {
          ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
          "$slot": {
            ".write": "$slot.matches(/^[0-7]$/) && root.child('rooms').child($room).child('allowed').child(auth.uid).exists() && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
          }
        },
        "intents": {
          ".read": "root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid",
          "$intent": {
            ".write": "(!data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($room).child('members').child(auth.uid).exists()) || (!newData.exists() && root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid)"
          }
        },
        "log": {
          ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
          "$n": {
            ".write": "!data.exists() && root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid"
          }
        },
        "snapshot": {
          ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
          ".write": "root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid"
        },
        "hands": {
          "$uid": {
            ".read": "auth.uid === $uid",
            ".write": "root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid"
          }
        },
        "hostState": {
          ".read": "root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid",
          ".write": "root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid"
        },
        "votes": {
          ".read": "root.child('rooms').child($room).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth.uid === $uid && root.child('rooms').child($room).child('members').child(auth.uid).exists()"
          }
        },
        "results": {
          ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
          ".write": "root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid"
        }
      }
    },
    "tables": {
      "$group": {
        ".read": "auth != null",
        "$room": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid && root.child('rooms').child($room).child('meta/groupId').val() === $group) || (data.exists() && !newData.exists() && root.child('rooms').child($room).child('allowed').child(auth.uid).exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['gameId', 'hostUid', 'hostName', 'createdAt']) && newData.child('gameId').isString() && newData.child('gameId').val().length <= 16 && newData.child('hostName').isString() && newData.child('hostName').val().length <= 40 && newData.child('createdAt').val() === now)"
        }
      }
    },
    "presence": {
      "$room": {
        ".read": "root.child('rooms').child($room).child('allowed').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth.uid === $uid && root.child('rooms').child($room).child('allowed').child(auth.uid).exists()"
        }
      }
    },
    "chat": {
      "$room": {
        ".read": "root.child('rooms').child($room).child('members').child(auth.uid).exists() || root.child('rooms').child($room).child('spectators').child(auth.uid).exists()",
        "$msg": {
          ".write": "!data.exists() && (root.child('rooms').child($room).child('members').child(auth.uid).exists() || root.child('rooms').child($room).child('spectators').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['uid', 'text', 'ts']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 200 && newData.child('ts').val() === now && newData.parent().parent().parent().child('chatRate').child($room).child(auth.uid).val() === now"
        }
      }
    },
    "chatRate": {
      "$room": {
        "$uid": {
          ".write": "auth.uid === $uid",
          ".validate": "newData.val() === now && (!data.exists() || data.val() <= now - 1000)"
        }
      }
    }
  }
}
