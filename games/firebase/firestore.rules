rules_version = '2';

// Stats, achievements and chat reports (docs/decisions.md, P3). The uid is
// the player's Supabase user id, signed in with a custom token (P2).
service cloud.firestore {
  match /databases/{database}/documents {
    // The owner writes and any signed-in EFOC player reads. Firestore can't
    // see Supabase groups, so "friends read" means every signed-in player.
    match /users/{uid}/stats/{gameId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/achievements/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Anyone signed in can file a report; nobody reads them from the app.
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
